#! /bin/bash
# Returns a reasonably formatted indicator showing play status

symbol() {
	[[ $(playerctl status) == "Playing" ]] && echo $' ' || echo $''
}

# SONE reports favorited tracks as userRating 1.0
heart() {
	[[ $(playerctl metadata xesam:userRating 2>/dev/null) == "1.0" ]] && echo $' '
}

echo "$(heart)$(playerctl metadata artist) - $(playerctl metadata title) $(symbol)"
